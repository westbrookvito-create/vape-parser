# Telegram-бот (получить у @BotFather)
BOT_TOKEN=123456:AAExampleBotTokenReplaceMe

# URL, где задеплоен фронтенд Mini App (должен быть https)
WEBAPP_URL=https://your-frontend-domain.example

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/hstlgram?schema=public

# Порт HTTP API
PORT=3000

# Список доменов фронтенда для CORS через запятую
CORS_ORIGIN=http://localhost:5173

# Telegram ID пользователей, которые получают доступ к админ-панели (через запятую).
# Узнать свой ID можно у @userinfobot в Telegram.
ADMIN_TELEGRAM_IDS=123456789
