# Скопируйте этот файл в .env и заполните своими значениями.
# .env не должен попадать в git (уже добавлен в .gitignore).

# Получить на https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Номер телефона аккаунта, от которого будет работать парсер (в международном формате)
TG_PHONE=+79991234567

# Имя файла Telethon-сессии (создастся автоматически при первом запуске)
TG_SESSION_NAME=vape_parser_session

# --- Пути к файлам (можно оставить по умолчанию) ---
DB_PATH=vape_shops.db
EXPORT_PATH=vape_shops.xlsx
CHANNELS_FILE=channels.txt
LOG_FILE=parser_errors.log

# --- Ограничение скорости запросов ---
REQUEST_DELAY_SECONDS=2.0
MESSAGES_TO_SCAN=20

# --- Поиск каналов по ключевым словам ---
ENABLE_KEYWORD_SEARCH=false
